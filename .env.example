# Azure DevOps configuration
MCP_AZURE_DEVOPS_ORG=your-organization-name
MCP_AZURE_DEVOPS_PROJECT=your-project-name
MCP_AZDO_PAT=your-personal-access-token

# GitHub configuration
MCP_GITHUB_OWNER=your-github-username-or-org
MCP_GITHUB_REPO=your-repository-name
MCP_GITHUB_TOKEN=your-github-personal-access-token

# Redmine configuration
MCP_REDMINE_URL=https://your-redmine-instance.example.com
MCP_REDMINE_PROJECT=your-project-identifier
MCP_REDMINE_API_KEY=your-redmine-api-key
# Optional: "false" to disable TLS verification (self-signed/internal CA),
# or a path to a CA bundle file. Leave empty for default system CA verification.
MCP_REDMINE_VERIFY_SSL=
# Optional: declare the Redmine version (e.g. 6.1, 7.0). Supported: 4.2 – 7.x.
# When set, the connector validates it against the server at startup and fails
# fast on a mismatch. When empty, the version is auto-detected from a single
# probe of the X-Redmine-Version response header.
MCP_REDMINE_VERSION=
